PORT=3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/script2video?retryWrites=true&w=majority
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PIXABAY_API_KEY=
TTS_VOICE=en-US-GuyNeural
TTS_VOICE_CHARACTER=en-US-AnaNeural
SILENT_SCENE_SECONDS=4
MIN_SCENE_SECONDS=3

# FFmpeg is found automatically. Only set these if the server says it cannot find it.
# Use the full path to the .exe file (no quotes needed):
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# ---- Only needed when the site is public ----
# Asks every visitor for this password (any user name works):
# APP_PASSWORD=choose-a-long-password
# Limit how many videos one visitor can make per hour (0 or empty = no limit):
# MAX_VIDEOS_PER_HOUR=3
# How many videos may render at the same time. Keep 1 on small free servers:
# MAX_PARALLEL_JOBS=1
# Set to 1 when the host puts a proxy in front of the app (Render, most hosts), so limits see real visitors:
# TRUST_PROXY=1
